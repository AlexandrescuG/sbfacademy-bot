# ─── SBF Academy Bot — конфигурация ───────────────────────────────────────────
# Скопируйте этот файл как .env и заполните свои значения

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID администраторов через запятую (Telegram user_id)
ADMIN_IDS=123456789,987654321

# Пароль для Flask-панели администратора
ADMIN_PASSWORD=your-admin-password

# Flask session secret
FLASK_SECRET=your-random-secret-string

# ID канала "Leads SBF" для уведомлений о лидах
# (отрицательное число — это ID группы/канала)
LEADS_CHANNEL_ID=-1001234567890

# Telegram ID менеджера для личных уведомлений о лидах (0 = отключено)
MANAGER_CHAT_ID=https://t.me/SBF_Support

# ─── Mini App URL ──────────────────────────────────────────────────────────────
# Phase 2: заменить на реальный URL деплоя webapp/
# До деплоя — используется sbfconsult.com как placeholder для кнопки меню
WEBAPP_URL=https://sbfconsult.com

# ─── SBFCRM интеграция ─────────────────────────────────────────────────────────
# URL SBFCRM (по умолчанию https://web.sbfconsult.com)
SBFCRM_URL=https://web.sbfconsult.com

# Сервисный аккаунт для создания лидов (email + пароль)
SBFCRM_EMAIL=
SBFCRM_PASSWORD=

# ─── market_intel брифинг ──────────────────────────────────────────────────────
# Путь к папке с отчётами market_intel (report_YYYY-MM-DD.md)
MARKET_INTEL_REPORT_DIR=/home/sbf/market_intel/data/reports

# Время запуска ingest в UTC (после батча market_intel, по умолчанию 10:15)
BRIEFING_INGEST_HOUR=10
BRIEFING_INGEST_MINUTE=15

# ─── FastAPI / APK auth ────────────────────────────────────────────────────────
# Секрет для подписи JWT (минимум 32 символа, случайная строка)
JWT_SECRET=

# Срок жизни initData из Telegram (секунды, 0 = без ограничения)
TMA_MAX_AGE_SEC=86400

# Google OAuth Client ID (Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID → Web application). Не секрет — используется и на бэкенде
# (проверка aud), и на фронтенде (кнопка входа), можно смело коммитить в app.js.
GOOGLE_CLIENT_ID=

# ─── Firebase Cloud Messaging (push-уведомления в APK) ───────────────────────
# Один из двух вариантов:
# 1) JSON-строка сервисного аккаунта (удобно для env-переменных на сервере)
FIREBASE_SERVICE_ACCOUNT_JSON=

# 2) Путь к файлу сервисного аккаунта (удобно при локальной разработке)
FIREBASE_SERVICE_ACCOUNT_PATH=
