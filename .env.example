# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789                # Telegram ID администраторов (через запятую)
ADMIN_PASSWORD=your_admin_password

# ── Уведомления ───────────────────────────────────────────────────────────────
MANAGER_CHAT_ID=123456789          # Telegram ID менеджера для уведомлений о лидах
LEADS_CHANNEL_ID=-1001234567890   # ID канала для лидов

# ── Операторы (Flask) ─────────────────────────────────────────────────────────
OPERATOR_IDS=123456789             # Telegram ID операторов (через запятую)
FLASK_SECRET_KEY=your_random_hex_secret_key_here

# ── EspoCRM (опционально) ─────────────────────────────────────────────────────
ESPOCRM_URL=https://crm.yourdomain.com
ESPOCRM_API_KEY=your_espocrm_api_key
